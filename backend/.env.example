# Copiar como .env (local) o cargar en AWS como variables de entorno. Nunca subir el .env real.
PORT=3000
NODE_ENV=production
# Polling y crons: true en el servidor publicado. En local, false mientras AWS esté prendido (evita cobros dobles).
CRONS_ACTIVOS=true

# Direcciones del frontend que pueden usar la API, separadas por coma, sin barra final.
FRONTEND_URL=https://tu-proyecto.vercel.app

# Base de datos (Supabase → Connect → Session pooler, que funciona por IPv4)
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=postgres

# Clerk (Dashboard → API Keys)
CLERK_SECRET_KEY=sk_test_...
# Solo para pruebas locales. Publicado tiene que quedar en false (con NODE_ENV=production el servidor no arranca si está en true).
BYPASS_CLERK_AUTH=false

# Banco Central simulado
CENTRAL_BANK_URL=
CENTRAL_BANK_API_KEY=
CENTRAL_BANK_CODE=
CENTRAL_BANK_ENV=

# Gemini (chat con Ban)
GEMINI_API_KEY=
